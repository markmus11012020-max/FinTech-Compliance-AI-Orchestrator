# ===== Database =====
DB_USER=postgres
DB_PASSWORD=secure_pass

# ===== LLM Provider =====
# Доступные значения: mock | yandexgpt | gigachat
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=10
LLM_TEMPERATURE=0.2

# ===== YandexGPT (Yandex Cloud Foundation Models) =====
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/latest

# ===== GigaChat (Sber) =====
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Pro